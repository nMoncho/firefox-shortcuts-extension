{
  "manifest_version": 2,
  "name": "Page Shortcuts",
  "version": "1.0.0",
  "description": "Inject custom keyboard shortcuts into any webpage via shortcuts.json",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg"
    },
    "default_popup": "popup.html",
    "default_title": "Page Shortcuts"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": ["shortcuts.json"]
}
